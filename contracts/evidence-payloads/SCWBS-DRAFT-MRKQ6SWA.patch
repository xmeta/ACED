+    ["diff", "--cached", "--name-only", "--ignore-submodules=dirty", "HEAD"],
+    "git diff --cached failed"
+  ).filter(include);
+  const unstaged = gitLines(
+    root,
+    ["diff", "--name-only", "--ignore-submodules=dirty"],
+    "git diff failed"
+  ).filter(include);
+  const untracked = gitLines(
