+    ["ls-files", "--others", "--exclude-standard"],
+    "git ls-files failed"
+  ).filter(include);
+  const submodules = dirtySubmodulePaths(root).filter(include);
+  return {
+    staged,
+    unstaged,
+    untracked,
+    submodules,
+    changedFiles: Array.from(new Set([...staged, ...unstaged, ...untracked, ...submodules]))
+  };
