++  const child = spawn(process.execPath, args, { cwd: process.cwd(), env: process.env, stdio: "inherit" });
++  return new Promise((resolve, reject) => {
++    child.on("error", reject);
++    child.on("close", (code) => resolve(code ?? 1));
++  });
++}
