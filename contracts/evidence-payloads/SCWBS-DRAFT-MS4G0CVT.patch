++    mkdirSync(path.dirname(lockPath), { recursive: true });
++    const descriptor = openSync(lockPath, "wx");
++    try {
++      writeFileSync(descriptor, `${JSON.stringify(state, null, 2)}\n`, "utf8");
++    } finally {
