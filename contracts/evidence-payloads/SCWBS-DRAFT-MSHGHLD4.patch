+const agentManifestPath = ".scwbs/agent-files.json";
+
+function agentFiles(agent: Agent, language: Language): AgentFile[] {
+  const languageLine = language === "ja" ? "Use Japanese for project-facing handoffs when practical." : "Use English for project-facing handoffs.";
+  const common = `<!-- Generated by scwbs. Keep local customizations in a separate file. -->\n\n# SC-WBS project workflow\n\nFollow the repository's AGENTS.md and SC-WBS Task Contract before changing files.\n${languageLine}\n\n- Read the active Task Contract and stay within allowed paths.\n- Run required checks and collect Evidence before reporting completion.\n- Stop for Human Gate, schema, dependency, authentication, or release decisions.\n`;
+  switch (agent) {
+    case "codex":
+      return [{ path: "AGENTS.md", content: `${common}\nUse scwbs packet --task <id> for the bounded work packet.\n` }];
+    case "claude":
+      return [{ path: ".claude/commands/scwbs.md", content: `${common}\nUse npm run scwbs -- packet --task <id> before implementation.\n` }];
+    case "cursor":
+      return [{ path: ".cursor/rules/scwbs.mdc", content: `${common}\nUse the Task Contract as the source of truth for every edit.\n` }];
+    case "copilot":
+      return [{ path: ".github/copilot-instructions.md", content: `${common}\nUse the repository's SC-WBS CLI commands through the npm script.\n` }];
+  }
+}
+
+function sha256(content: string): string {
+  return createHash("sha256").update(content, "utf8").digest("hex");
+}
+
+function readAgentManifest(root: string): AgentManifest | undefined {
+  const fullPath = resolveFrom(root, agentManifestPath);
+  if (!existsSync(fullPath)) return undefined;
+  try {
+    const parsed = JSON.parse(readFileSync(fullPath, "utf8")) as AgentManifest;
+    if (parsed.schemaVersion !== "1" || !Array.isArray(parsed.files)) return undefined;
+    return parsed;
+  } catch {
+    return undefined;
+  }
+}
+
+function writeAgentManifest(root: string, agent: Agent, files: AgentFile[]): void {
+  const fullPath = resolveFrom(root, agentManifestPath);
+  mkdirSync(dirname(fullPath), { recursive: true });
+  const manifest: AgentManifest = {
+    schemaVersion: "1",
+    agent,
+    files: files.map((file) => ({ path: file.path, sha256: sha256(file.content) }))
+  };
+  writeFileSync(fullPath, `${JSON.stringify(manifest, null, 2)}\n`, "utf8");
+}
+
+function syncAgentFiles(root: string, agent: Agent, language: Language, update: boolean): string[] {
+  const files = agentFiles(agent, language);
