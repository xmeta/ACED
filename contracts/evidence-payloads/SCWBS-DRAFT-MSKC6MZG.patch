+          description: "A",
+          dependencies: ["missing"],
+          completion: { mode: "path-exists", extra: true }
+        },
+        {
+          id: "same",
+          path: "../outside.ts",
+          description: "B",
+          dependencies: ["same"],
+          authority: "allow",
+          completion: { mode: "path-exists" }
+        }
+      ]
+    });
