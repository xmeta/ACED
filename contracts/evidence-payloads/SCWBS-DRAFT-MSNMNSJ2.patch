+              return {
+                name,
+                checkNames: name === "core" ? ["test", "typecheck", "build"] : name === "integration" ? ["test:integration"] : [],
+                jobId: String(check.id),
+                conclusion: "success",
+                url: check.details_url,
+                workflowRunId: process.env.SCWBS_WORKFLOW_RUN_ID,
+                workflowPath
+              };
+            });
+            jobs.push({
+              name: "validate",
