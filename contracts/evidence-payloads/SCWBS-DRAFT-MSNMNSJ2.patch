+              taskId: process.env.SCWBS_TASK_ID,
+              headCommit: process.env.SCWBS_HEAD_COMMIT,
+              baseRef: "origin/main",
+              baseCommit: process.env.SCWBS_BASE_COMMIT,
+              diffHash: process.env.SCWBS_DIFF_HASH,
