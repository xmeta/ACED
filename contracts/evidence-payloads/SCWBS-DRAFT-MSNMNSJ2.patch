+            const ciBytes = Buffer.from(`${JSON.stringify(ciReceipt, null, 2)}\n`, "utf8");
+            const artifactName = `scwbs-ci-receipt-${process.env.SCWBS_WORKFLOW_RUN_ID}`;
+            const readiness = {
