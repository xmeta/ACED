+              workflowRunId: process.env.SCWBS_WORKFLOW_RUN_ID,
+              workflowRunUrl: process.env.SCWBS_WORKFLOW_RUN_URL,
+              trustedCommit: process.env.SCWBS_HEAD_COMMIT,
+              retrievedAt: new Date().toISOString(),
