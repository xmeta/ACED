+    writeJson(root, "ours.json", ours);
+    writeJson(root, "theirs.json", theirs);
+    writeJson(root, "contracts/wbs/project.wbs.json", base);
+    const before = readFileSync(`${root}/contracts/wbs/project.wbs.json`, "utf8");
