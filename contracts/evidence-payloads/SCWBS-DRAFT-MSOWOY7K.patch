+      "properties": { "locator": { "type": "string", "minLength": 1, "maxLength": 256 }, "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
+    },
+    "attestation": {
+      "type": "object", "additionalProperties": false, "required": ["locator"],
+      "properties": {
+        "locator": { "type": "string", "minLength": 1, "maxLength": 256 },
+        "bundle": { "type": "string", "minLength": 1, "maxLength": 256 },
