+
+function artifactInventory(root: string): ArtifactInventoryEntry[] {
+  return [
+    ...listSpecs(root).map(({ spec, issues, path: artifactPath }) => spec ? {
+      kind: "spec" as const,
+      id: spec.id,
+      path: artifactPath,
