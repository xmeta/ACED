{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xmeta.github.io/ACED/schemas/ai-execution.schema.json",
  "title": "SC-WBS bounded AI execution artifacts",
  "oneOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/planV2"
    },
    {
      "$ref": "#/$defs/receiptV2"
    }
  ],
  "$defs": {
    "pathList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capabilities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["implement", "review", "debug", "fresh-context", "json-io"] }
        }
      }
    },
    "learnedNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceTaskId", "sourceHeadCommit", "scope", "note"],
      "properties": {
        "sourceTaskId": { "type": "string", "pattern": "^SCWBS-[A-Z0-9-]+$" },
        "sourceHeadCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "scope": { "$ref": "#/$defs/pathList", "maxItems": 8 },
        "note": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "executionId",
        "taskId",
        "iteration",
        "phase",
        "branch",
        "expectedBranch",
        "subjectHeadCommit",
        "authorityFingerprint",
        "allowedPaths",
        "forbiddenPaths",
        "humanGateRequiredPaths",
        "requiredChecks",
        "implementer",
        "reviewer",
        "automaticPullRequest",
        "automaticMerge",
        "debugger"
      ],
      "properties": {
        "schemaVersion": { "const": "scwbs.ai-execution-plan.v1" },
        "executionId": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "iteration": { "const": 1 },
        "phase": { "const": "phase-1" },
        "branch": { "type": "string", "minLength": 1 },
        "expectedBranch": { "type": "string", "minLength": 1 },
        "subjectHeadCommit": { "type": "string", "minLength": 1 },
        "authorityFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "allowedPaths": { "$ref": "#/$defs/pathList" },
        "forbiddenPaths": { "$ref": "#/$defs/pathList" },
        "humanGateRequiredPaths": { "$ref": "#/$defs/pathList" },
        "requiredChecks": { "$ref": "#/$defs/pathList" },
        "implementer": { "$ref": "#/$defs/adapter" },
        "reviewer": { "$ref": "#/$defs/adapter" },
        "automaticPullRequest": { "const": false },
        "automaticMerge": { "const": false },
        "debugger": { "const": false },
        "learnedNotes": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/learnedNote" } }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "contextId", "freshContext"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "contextId": { "type": "string", "minLength": 1 },
        "freshContext": { "const": true },
        "provider": { "$ref": "#/$defs/provider" }
      }
    },
    "planV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "executionId", "taskId", "iteration", "phase", "branch", "expectedBranch", "subjectHeadCommit", "authorityFingerprint", "allowedPaths", "forbiddenPaths", "humanGateRequiredPaths", "requiredChecks", "implementer", "reviewer", "automaticPullRequest", "automaticMerge", "debugger", "maxRemediationRounds"],
      "properties": {
        "schemaVersion": { "const": "scwbs.ai-execution-plan.v2" },
        "executionId": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "iteration": { "type": "integer", "minimum": 1 },
        "phase": { "const": "phase-2" },
        "branch": { "type": "string", "minLength": 1 },
        "expectedBranch": { "type": "string", "minLength": 1 },
        "subjectHeadCommit": { "type": "string", "minLength": 1 },
        "authorityFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "allowedPaths": { "$ref": "#/$defs/pathList" },
        "forbiddenPaths": { "$ref": "#/$defs/pathList" },
        "humanGateRequiredPaths": { "$ref": "#/$defs/pathList" },
        "requiredChecks": { "$ref": "#/$defs/pathList" },
        "implementer": { "$ref": "#/$defs/adapter" },
        "reviewer": { "$ref": "#/$defs/adapter" },
        "automaticPullRequest": { "const": false },
        "automaticMerge": { "const": false },
        "debugger": { "$ref": "#/$defs/adapter" },
        "maxRemediationRounds": { "const": 2 },
        "resumeFrom": { "type": "string", "minLength": 1 },
        "learnedNotes": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/learnedNote" } }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "role", "contextId", "taskId", "iteration"],
      "properties": {
        "schemaVersion": { "const": "scwbs.ai-execution-input.v1" },
        "role": { "enum": ["implementer", "reviewer", "debugger"] },
        "contextId": { "type": "string", "minLength": 1 },
        "freshContext": { "const": true },
        "taskId": { "type": "string", "minLength": 1 },
        "iteration": { "type": "integer", "minimum": 1 }
      }
    },
    "debuggerResult": {
      "allOf": [
        { "$ref": "#/$defs/result" },
        {
          "properties": {
            "role": { "const": "debugger" },
            "rootCause": { "type": "string", "minLength": 1 },
            "category": { "type": "string", "minLength": 1 },
            "fixPlan": { "type": "string", "minLength": 1 },
            "nextAction": { "type": "string", "minLength": 1 }
          },
          "required": ["rootCause", "category", "fixPlan", "nextAction"]
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "role", "contextId", "status", "summary"],
      "properties": {
        "schemaVersion": { "const": "scwbs.ai-execution-result.v1" },
        "role": { "enum": ["implementer", "reviewer", "debugger"] },
        "contextId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["completed", "blocked", "manual-review-required", "approved", "changes-requested"] },
        "summary": { "type": "string", "minLength": 1 },
        "findings": { "$ref": "#/$defs/pathList" },
        "changedFiles": { "$ref": "#/$defs/pathList" },
        "rootCause": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "fixPlan": { "type": "string", "minLength": 1 },
        "nextAction": { "type": "string", "minLength": 1 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "executionId", "taskId", "iteration", "status", "plan"],
      "properties": {
        "schemaVersion": { "const": "scwbs.ai-run-receipt.v1" },
        "executionId": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "iteration": { "const": 1 },
        "status": { "enum": ["completed", "blocked"] },
        "plan": { "$ref": "#/$defs/plan" },
        "implementer": { "$ref": "#/$defs/result" },
        "checks": { "type": "object" },
        "reviewer": { "$ref": "#/$defs/result" },
        "changedFiles": { "$ref": "#/$defs/pathList" },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "code", "message"],
          "properties": {
            "stage": { "enum": ["preflight", "implementer", "checks", "reviewer"] },
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        },
        "receiptPath": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "minLength": 1 },
        "endedAt": { "type": "string", "minLength": 1 },
        "cost": { "$ref": "#/$defs/cost" }
      }
    },
    "receiptV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "executionId", "taskId", "iteration", "status", "plan"],
      "properties": {
        "schemaVersion": { "const": "scwbs.ai-run-receipt.v2" },
        "executionId": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "iteration": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["completed", "blocked"] },
        "plan": { "$ref": "#/$defs/planV2" },
        "implementer": { "$ref": "#/$defs/result" },
        "checks": { "type": "object" },
        "reviewer": { "$ref": "#/$defs/result" },
        "changedFiles": { "$ref": "#/$defs/pathList" },
        "remediation": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["round", "debugger", "implementer"],
            "properties": {
              "round": { "type": "integer", "minimum": 1, "maximum": 2 },
              "debugger": { "$ref": "#/$defs/debuggerResult" },
              "implementer": { "$ref": "#/$defs/result" },
              "checks": { "type": "object" },
              "reviewer": { "$ref": "#/$defs/result" }
            }
          }
        },
        "failure": { "$ref": "#/$defs/receipt/properties/failure" },
        "receiptPath": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "minLength": 1 },
        "endedAt": { "type": "string", "minLength": 1 },
        "cost": { "$ref": "#/$defs/cost" }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallTimeMilliseconds", "agentTurns", "remediationRounds", "requiredChecksObserved", "requiredChecksReused", "requiredCheckReuseRate"],
      "properties": {
        "wallTimeMilliseconds": { "type": ["integer", "null"], "minimum": 0 },
        "agentTurns": { "type": "integer", "minimum": 0 },
        "remediationRounds": { "type": "integer", "minimum": 0, "maximum": 2 },
        "requiredChecksObserved": { "type": "integer", "minimum": 0 },
        "requiredChecksReused": { "type": "integer", "minimum": 0 },
        "requiredCheckReuseRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    }
  }
}
