{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xmeta.example/scwbs/checks-run-summary.schema.json",
  "title": "SC-WBS required checks run summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "taskId", "headCommit", "subjectFingerprint", "receiptPath", "receiptReason", "checks"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["pass", "fail"] },
    "taskId": { "type": "string", "minLength": 1 },
    "headCommit": { "type": "string", "minLength": 1 },
    "subjectFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "receiptPath": { "type": ["string", "null"] },
    "receiptReason": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "disposition", "reason", "command", "cacheKey"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "disposition": { "enum": ["executed", "reused", "not-run"] },
          "reason": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "cacheKey": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "exitStatus": { "type": "integer" },
          "stdoutSummary": { "type": "string", "maxLength": 1000 },
          "stderrSummary": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  }
}
