{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scwbs.dev/schemas/governance-pack.v1.json",
  "title": "SC-WBS Governance Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "contents", "security"],
  "properties": {
    "schemaVersion": { "const": "scwbs.pack.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "maxLength": 1000 },
    "requires": { "type": "object", "additionalProperties": { "type": "string" } },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "oneOf": [
              { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(?:/|$)).+" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["source"],
                "properties": {
                  "source": { "type": "string" },
                  "target": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredChecks": { "type": "array", "items": { "type": "string" } },
        "humanGatePaths": { "type": "array", "items": { "type": "string" } },
        "forbiddenPaths": { "type": "array", "items": { "type": "string" } },
        "removeRequiredChecks": { "type": "array", "items": { "type": "string" } },
        "removeHumanGatePaths": { "type": "array", "items": { "type": "string" } },
        "removeForbiddenPaths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowExecutableCode"],
      "properties": { "allowExecutableCode": { "const": false } }
    }
  }
}
