{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xmeta.github.io/ACED/scwbs.next.v1.schema.json",
  "title": "SC-WBS next JSON output",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "action", "reasons"],
  "properties": {
    "version": { "const": "scwbs.next.v1" },
    "status": { "enum": ["actionable", "waiting", "idle"] },
    "action": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "owner": { "enum": ["ai", "human"] },
            "taskId": { "type": "string", "minLength": 1 },
            "command": { "type": "string", "minLength": 1 },
            "aiStop": { "type": "boolean" }
          }
        }
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string" }
        }
      }
    }
  }
}
