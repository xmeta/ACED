{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xmeta/ACED/blob/main/docs/scwbs/schemas/query.schema.json",
  "title": "SC-WBS local index query output",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "query", "total", "omitted", "results", "reasons"],
  "properties": {
    "version": { "const": "scwbs.query.v1" },
    "status": { "enum": ["ready", "missing", "stale", "corrupt"] },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kinds", "unverified", "stale", "limit"],
      "properties": {
        "text": { "type": "string", "maxLength": 256 },
        "kinds": { "type": "array", "items": { "type": "string" }, "maxItems": 10, "uniqueItems": true },
        "status": { "type": "string", "maxLength": 64 },
        "unverified": { "type": "boolean" },
        "stale": { "type": "boolean" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "indexedAt": { "type": "string" },
    "repositoryHead": { "type": "string" },
    "total": { "type": "integer", "minimum": 0, "maximum": 100 },
    "omitted": { "type": "integer", "minimum": 0 },
    "results": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "status", "sourcePath", "sourceHash", "schemaVersion", "indexedAt", "repositoryHead", "locator", "stale", "snippet"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "title": { "type": "string", "maxLength": 500 },
          "status": { "type": "string", "maxLength": 64 },
          "sourcePath": { "type": "string" },
          "sourceHash": { "type": "string", "pattern": "^sha256:" },
          "schemaVersion": { "type": "string" },
          "indexedAt": { "type": "string" },
          "repositoryHead": { "type": "string" },
          "locator": { "type": "string" },
          "stale": { "type": "boolean" },
          "snippet": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "reasons": { "type": "array", "items": { "type": "string" }, "maxItems": 20 }
  }
}
