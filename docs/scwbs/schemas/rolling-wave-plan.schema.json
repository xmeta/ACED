{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/scwbs/rolling-wave-plan.schema.json",
  "title": "SC-WBS Rolling Wave Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "type",
    "specId",
    "specVersion",
    "generatedAt",
    "planningMode",
    "inputs",
    "approachMap",
    "readyWindow",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^PLAN-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "type": { "const": "rolling-wave-plan" },
    "specId": { "type": "string", "minLength": 1 },
    "specVersion": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "planningMode": { "enum": ["probe", "delivery"] },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptanceCriteria",
        "unresolvedDecisions",
        "dependencies",
        "gates",
        "uncertainty",
        "probeResults"
      ],
      "properties": {
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unresolvedDecisions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "uncertainty": { "enum": ["low", "medium", "high"] },
        "probeResults": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": {
                "enum": ["missing", "proposed", "active", "concluded", "inconclusive"]
              }
            }
          }
        }
      }
    },
    "approachMap": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "status"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "status": { "const": "candidate" }
        }
      }
    },
    "readyWindow": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "title", "paths"],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "probe": { "type": "string", "minLength": 1 }
      }
    },
    "replan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "previousHash", "changes"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "previousHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["added", "removed", "retained"],
          "properties": {
            "added": {
              "type": "array",
              "items": { "type": "string" }
            },
            "removed": {
              "type": "array",
              "items": { "type": "string" }
            },
            "retained": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "planningMode": { "const": "delivery" } },
        "required": ["planningMode"]
      },
      "then": {
        "properties": {
          "readyWindow": { "minItems": 1, "maxItems": 3 },
          "artifacts": {
            "properties": {
              "tasks": { "minItems": 1, "maxItems": 3 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "planningMode": { "const": "probe" } },
        "required": ["planningMode"]
      },
      "then": {
        "properties": {
          "readyWindow": { "maxItems": 0 },
          "artifacts": { "required": ["probe"] }
        }
      }
    }
  ]
}
