{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/scwbs/task-classification.schema.json",
  "title": "SC-WBS read-only task execution classification",
  "type": "object",
  "required": ["schemaVersion", "status", "projectProfile", "executionClass", "enforcement", "bootstrapAuthority", "consideredFiles", "excludedBootstrapFiles", "reasons"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["classified", "unavailable"] },
    "projectProfile": { "enum": ["Lean", "Standard", "Strict", null] },
    "executionClass": { "enum": ["routine", "standard", "high-risk", null] },
    "enforcement": { "const": "read-only" },
    "bootstrapAuthority": { "type": "object", "required": ["verified", "introductionCommit"], "properties": { "verified": { "type": "boolean" }, "introductionCommit": { "type": ["string", "null"] } }, "additionalProperties": false },
    "consideredFiles": { "type": "array", "items": { "type": "string" } },
    "excludedBootstrapFiles": { "type": "array", "items": { "type": "string" } },
    "reasons": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } }, "additionalProperties": false } }
  },
  "additionalProperties": false
}
