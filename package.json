{
  "name": "scwbs",
  "version": "0.1.0",
  "description": "CLI for SC-WBS Development with WBS-JSON integration.",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "wjs"
  ],
  "type": "module",
  "bin": {
    "scwbs": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.{js,mjs,ts}\" \"*.{js,json,md,ts,yaml,yml}\" \".github/**/*.yml\" \"docs/**/*.{json,md,yaml,yml}\"",
    "lint": "eslint src tests scripts --max-warnings=37",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run tests/unit",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:coverage:all": "vitest run tests/unit tests/integration --coverage --pool=forks --maxWorkers=4 --no-file-parallelism --testTimeout=60000 -t='^(?!.*bounds events per Task and receipts per repository)'",
    "test:integration": "node scripts/integration-test-output.mjs",
    "test:integration:verbose": "node scripts/integration-test-output.mjs --verbose",
    "test:wjs": "npm test -w wjs",
    "test:all": "npm run test && npm run test:integration && npm run test:wjs",
    "scwbs": "node scripts/scwbs-run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "9.39.5",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "js-yaml": "^5.2.2"
  }
}
